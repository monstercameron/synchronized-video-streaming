# Copy to .env next to compose.yaml:  cp deploy/docker/env.example .env

# Which image to run. "latest" follows main; a tag such as 1.0.0 or a commit (sha-abc1234) pins one.
IMAGE=ghcr.io/monstercameron/synchronized-video-streaming:latest

# Host folder for videos (DATA_DIR/media) and the database. Create it first and give it to uid 1000:
#   sudo mkdir -p /srv/screening/media && sudo chown -R 1000:1000 /srv/screening
DATA_DIR=/srv/screening

# Your domain (used by the HTTPS config), and which Nginx config to use: nginx-http.conf first, nginx-tls.conf after the
# certificate exists.
DOMAIN=your.domain.example
NGINX_CONF=nginx-http.conf

# The admin password: unlocks the site, and authorizes uploads, deleting videos, closing rooms and removing people.
# Set a long random one. Without it the password is "password".
ADMIN_PASSWORD=change-me-to-something-long

# App settings (see deploy/screening.env.example for all of them).
MEDIA_QUOTA_GB=4
MAX_UPLOAD_GB=4
# METADATA_API_KEY=
# METADATA_MODEL=
# METADATA_API_BASE=
