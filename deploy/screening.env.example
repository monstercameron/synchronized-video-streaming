# Copy to /etc/screening.env on the droplet (owned by root, mode 640, group screening).
NODE_ENV=production

# Where videos live, and the database. Keep both outside the release folder so deploys never touch them.
MEDIA_DIR=/var/lib/screening/media
SCREENING_DB_PATH=/var/lib/screening/screening.sqlite

# Hand video bytes to Nginx after the app has checked access. Must match the "internal" location in the
# Nginx config. Leave it out to have the app stream files itself (fine for testing, heavier on the CPU).
MEDIA_ACCEL_PREFIX=/_media

# Largest single upload, in gigabytes. Keep in step with client_max_body_size in Nginx.
MAX_UPLOAD_GB=4

# Cap on the total size of the media folder (videos, adaptive folders, subtitles, posters), in gigabytes.
# Uploads that would pass it are refused, and the host can delete videos from the Video tab to make room.
MEDIA_QUOTA_GB=4

# Only needed if ffprobe is not on the PATH of the service.
# FFPROBE_PATH=/usr/bin/ffprobe

# Finding a video's title, synopsis and cast on the web (the host's "Find details" button). Off unless a key is set.
# Only the video's file name, title, length and picture size (and any hint the host types) are sent, and only when the host taps the button.
# METADATA_API_KEY=
# METADATA_MODEL=gpt-6-luna
# METADATA_API_BASE=https://api.openai.com/v1

# Nginx already compresses responses, so do not compress them a second time in Node (it only costs CPU).
COMPRESS=off
